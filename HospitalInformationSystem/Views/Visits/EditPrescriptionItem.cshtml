@model HospitalInformationSystem.Models.ViewModels.EditPrescriptionItemViewModel

@{
    ViewData["Title"] = "Edit Prescription Item";
}

<h1>Edit Prescription Item</h1>

<form asp-action="EditPrescriptionItem" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Dosage" class="form-label"></label>
        <input asp-for="Dosage" class="form-control" />
        <span asp-validation-for="Dosage"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Frequency" class="form-label"></label>
        <input asp-for="Frequency" class="form-control" />
        <span asp-validation-for="Frequency"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Days" class="form-label"></label>
        <input asp-for="Days"
               type="number"
               min="1"
               max="365"
               class="form-control" />
        <span asp-validation-for="Days"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}