@using HospitalInformationSystem.Models.Entities
@model HospitalInformationSystem.Models.Entities.Visit

@{
    ViewData["Title"] = "Visit Details";
}

<h1>Visit Details</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="mb-4">
    <h4>Patient</h4>

    <dl class="row">
        <dt class="col-sm-3">Medical Record Number</dt>
        <dd class="col-sm-9">@Model.Patient.MedicalRecordNumber</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Patient.FullName</dd>

        <dt class="col-sm-3">Birthday</dt>
        <dd class="col-sm-9">@Model.Patient.Birthday</dd>
    </dl>
</div>

<div class="mb-4">
    <h4>Visit</h4>

    <dl class="row">
        <dt class="col-sm-3">Visit Date / Time</dt>
        <dd class="col-sm-9">@Model.VisitDateTime</dd>

        <dt class="col-sm-3">Appointment Reason</dt>
        <dd class="col-sm-9">
            @(Model.Appointment?.Reason ?? "-")
        </dd>

        <dt class="col-sm-3">Chief Complaint</dt>
        <dd class="col-sm-9">
            @(Model.ChiefComplaint ?? "-")
        </dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">
            @(Model.Notes ?? "-")
        </dd>
    </dl>
</div>

<div class="mb-4">
    <h4>Diagnoses</h4>

    @if (Model.Diagnoses.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>

                    @if (Model.Appointment != null &&
                        Model.Appointment.Status == AppointmentStatus.Scheduled)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var diagnosis in Model.Diagnoses)
                {
                    <tr>
                        <td>@diagnosis.DiagnosisCode</td>
                        <td>@diagnosis.Description</td>

                        @if (Model.Appointment != null &&
                             Model.Appointment.Status == AppointmentStatus.Scheduled)
                        {
                            <td>
                                <a asp-action="EditDiagnosis"
                                   asp-route-id="@diagnosis.Id"
                                   class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <form asp-action="DeleteDiagnosis"
                                      asp-route-id="@diagnosis.Id"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No diagnoses recorded.</p>
    }
</div>

<hr />

<h3>Prescription</h3>

@if (Model.Prescription != null &&
     Model.Prescription.Items.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Medication</th>
                <th>Unit</th>
                <th>Dosage</th>
                <th>Frequency</th>
                <th>Days</th>

                @if (Model.Appointment != null &&
                        Model.Appointment.Status == AppointmentStatus.Scheduled)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Prescription.Items)
            {
                <tr>
                    <td>@item.Medication.Name</td>
                    <td>@item.Medication.Unit</td>
                    <td>@item.Dosage</td>
                    <td>@item.Frequency</td>
                    <td>@item.Days</td>

                    @if (Model.Appointment != null &&
                         Model.Appointment.Status == AppointmentStatus.Scheduled)
                    {
                        <td>
                            <a asp-action="EditPrescriptionItem"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <form asp-action="DeletePrescriptionItem"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No prescription recorded.</p>
}

@if (Model.Appointment != null &&
     Model.Appointment.Status == AppointmentStatus.Scheduled)
{
    <form asp-action="Complete"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">
        <button type="submit"
                class="btn btn-success">
            Complete Visit
        </button>
    </form>

    <a asp-action="AddPrescriptionItem"
       asp-route-visitId="@Model.Id"
       class="btn btn-primary">
        Add Medication
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit Clinical Notes
    </a>

    <a asp-action="AddDiagnosis"
       asp-route-visitId="@Model.Id"
       class="btn btn-primary">
        Add Diagnosis
    </a>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back to My Appointments
</a>