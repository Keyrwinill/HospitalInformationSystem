@model IEnumerable<HospitalInformationSystem.Models.Entities.Medication>

@{
    ViewData["Title"] = "Medications";
}

<h1>Medications</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Medication
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Unit</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var medication in Model)
        {
            <tr>
                <td>@medication.Code</td>
                <td>@medication.Name</td>
                <td>@medication.Unit</td>
                <td>
                    @(medication.IsActive ? "Active" : "Inactive")
                </td>
                <td>
                    @if (medication.IsActive)
                    {
                        <form asp-action="Deactivate"
                              asp-route-id="@medication.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate"
                              asp-route-id="@medication.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                Activate
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>