@model IEnumerable<HospitalInformationSystem.Models.Entities.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create Doctor
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Account</th>
            <th>Name</th>
            <th>Department</th>
            <th>License Number</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.User.Account</td>
                <td>@doctor.User.FirstName @doctor.User.LastName</td>
                <td>@doctor.Department.Name</td>
                <td>@doctor.LicenseNumber</td>
                <td>@doctor.IsActive</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@doctor.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    @if (doctor.IsActive)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@doctor.Id"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <form asp-action="Deactivate"
                              asp-route-id="@doctor.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate"
                              asp-route-id="@doctor.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                Activate
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>