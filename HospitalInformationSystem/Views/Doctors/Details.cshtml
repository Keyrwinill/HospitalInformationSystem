@model HospitalInformationSystem.Models.Entities.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<h1>Doctor Details</h1>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Account</dt>
    <dd class="col-sm-9">@Model.User.Account</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.User.Email</dd>

    <dt class="col-sm-3">License Number</dt>
    <dd class="col-sm-9">@Model.LicenseNumber</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department.Name</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive && Model.User.IsActive
            ? "Active"
            : "Inactive")
    </dd>
</dl>

@if (Model.IsActive && Model.User.IsActive)
{
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back to Doctors
</a>