@using HospitalInformationSystem.Models.Constants
@using System.Security.Claims
@model IEnumerable<HospitalInformationSystem.Models.Entities.User>

@{
    ViewData["Title"] = "Users";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1>Users</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create User
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Account</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Account</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@user.IsActive</td>

                <td>
                    @if (user.Role != UserRoles.Doctor)
                    {
                        if (user.IsActive)
                        {
                            if (user.Id.ToString() != currentUserId)
                            {
                                <form asp-action="Deactivate"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Deactivate
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <form asp-action="Activate"
                                  asp-route-id="@user.Id"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    Activate
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>