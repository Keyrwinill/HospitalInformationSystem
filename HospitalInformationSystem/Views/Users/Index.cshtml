@model IEnumerable<HospitalInformationSystem.Models.Entities.User>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create User
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Account</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Account</td>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@user.IsActive</td>
            </tr>
        }
    </tbody>
</table>