@model HospitalInformationSystem.Models.Entities.Department

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Description)
            ? "-"
            : Model.Description)
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>
</dl>

<h2>Doctors</h2>

@if (Model.Doctors.Count == 0)
{
    <p>No doctors in this department.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>License Number</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in Model.Doctors.OrderBy(x => x.User.FirstName)
                                                 .ThenBy(x => x.User.LastName))
            {
                <tr>
                    <td>@doctor.FullName</td>
                    <td>@doctor.LicenseNumber</td>
                    <td>
                        @(doctor.IsActive && doctor.User.IsActive
                            ? "Active"
                            : "Inactive")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to Departments
</a>