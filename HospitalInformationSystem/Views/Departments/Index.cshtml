@model IEnumerable<HospitalInformationSystem.Models.Entities.Department>

@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create Department
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.Name</td>
                <td>@department.Description</td>
                <td>@department.IsActive</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@department.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    @if (department.IsActive)
                    {
                        <form asp-action="Deactivate"
                              asp-route-id="@department.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate"
                              asp-route-id="@department.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                Activate
                            </button>
                        </form>
                    }

                    <a asp-action="Edit"
                       asp-route-id="@department.Id"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>